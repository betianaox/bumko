rules_version = '2';

// Cada bar es una cuenta cerrada: nadie de otro bar ve ni toca sus datos.
// usuarios/{email} dice a qué bar entra cada persona.
service cloud.firestore {
  match /databases/{database}/documents {
    function yo() { return request.auth.token.email; }
    function miembro(b) { return get(/databases/$(database)/documents/bares/$(b)/equipo/$(yo())).data; }
    function delBar(b) { return request.auth != null && exists(/databases/$(database)/documents/bares/$(b)/equipo/$(yo())) && miembro(b).active != false; }
    function esDev(b) { return delBar(b) && miembro(b).role == 'dev'; }
    // dev puede lo mismo que admin: es mantenimiento, no negocio
    function esAdmin(b) { return delBar(b) && (miembro(b).role == 'admin' || miembro(b).role == 'dev'); }
    // Puerta abierta: se anota solo el que llega por el link, siempre como staff.
    function abierta(b) { return get(/databases/$(database)/documents/bares/$(b)).data.autoJoin == true; }

    match /usuarios/{email} {
      allow read: if request.auth != null && yo() == email;
      allow create: if request.auth != null && yo() == email && abierta(request.resource.data.barId);
      allow write: if request.auth != null && esAdmin(request.resource.data.get('barId', resource.data.barId));
    }

    match /bares/{b} {
      // Cualquiera con sesión puede leer el bar: hace falta para saber si tiene
      // la puerta abierta antes de pertenecer a él. Son tres campos públicos.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.ownerEmail == yo();
      allow update, delete: if esAdmin(b);

      match /equipo/{email} {
        // El propio registro se lee siempre, aunque esté suspendido: si no, la
        // persona no puede ni enterarse de que está esperando aprobación.
        allow read: if delBar(b) || (request.auth != null && yo() == email);
        // Anotarse solo: siempre staff y siempre apagado, lo habilita un admin
        allow create: if request.auth != null && yo() == email && abierta(b)
          && request.resource.data.role == 'staff' && request.resource.data.active == false;
        // Nombrar o destituir devs es cosa de devs
        allow update: if esAdmin(b) && (request.resource.data.role != 'dev' || esDev(b)) && (resource.data.role != 'dev' || esDev(b));
        allow delete: if esAdmin(b) && (resource.data.role != 'dev' || esDev(b));
      }

      // El staff solo puede mover el stock; los demás campos son del admin.
      match /products/{id} {
        allow read: if delBar(b);
        allow create, delete: if esAdmin(b);
        allow update: if esAdmin(b) || (delBar(b) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']));
      }

      // Vender es lo único que escribe el staff, y solo puede borrar lo suyo.
      match /sales/{id} {
        allow read: if delBar(b);
        allow create: if delBar(b) && request.resource.data.userEmail == yo();
        allow delete: if esAdmin(b) || (delBar(b) && resource.data.userEmail == yo());
        allow update: if esAdmin(b);
      }

      match /events/{id} { allow read: if delBar(b); allow write: if esAdmin(b); }
      match /settings/{id} { allow read: if delBar(b); allow write: if esAdmin(b); }
    }
  }
}
