rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function myDoc() {
      return get(/databases/$(database)/documents/equipo_autorizado/$(request.auth.token.email)).data;
    }

    function isTeamMember() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/equipo_autorizado/$(request.auth.token.email)) &&
        myDoc().active != false;
    }

    function isAdmin() {
      return isTeamMember() && myDoc().role == 'admin';
    }

    match /equipo_autorizado/{email} {
      allow read: if request.auth != null;

      // Cada uno se registra a sí mismo la primera vez que entra, y siempre
      // como staff: nadie puede darse de alta directamente como admin.
      allow create: if request.auth != null
        && request.auth.token.email == email
        && request.resource.data.role == 'staff'
        && request.resource.data.email == email;

      // Cambiar roles o cortar accesos es solo de admin.
      allow update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read, write: if isTeamMember();
    }

    match /sales/{saleId} {
      allow read, write: if isTeamMember();
    }

    match /events/{eventId} {
      allow read, write: if isTeamMember();
    }

    // Config compartida del bar (por ahora, la caja con la que se arranca)
    match /settings/{docId} {
      allow read, write: if isTeamMember();
    }
  }
}
